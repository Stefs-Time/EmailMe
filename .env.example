# MailHarbor — Docker Compose configuration.
# Copy to .env and fill in. Never commit .env.
# Everything else (organisation, sender, bounce mailbox, sending speed…) is set
# in the app under Settings after the first sign-in.

# --- Web address (must point at this server) ---
DOMAIN=mail.example.co.za
# Let's Encrypt expiry notices
ACME_EMAIL=it@example.co.za

# --- Database (internal only) ---
# Generate with: openssl rand -base64 30
POSTGRES_PASSWORD=change-me

# --- SMTP: optional default mail server ---
# The customer normally enters their own server in Settings → Sending, which takes precedence.
# Leave SMTP_HOST empty if there is no default.
SMTP_HOST=smtp.example.co.za
# 587 = STARTTLS (recommended), 465 = TLS
SMTP_PORT=587
SMTP_USER=news@example.co.za
SMTP_PASSWORD=change-me
# Default sender shown in emails (can be changed in Settings)
SMTP_FROM="Example News <news@example.co.za>"

# --- Optional ---
TZ=Africa/Johannesburg
# MailHarbor support address, shown to the customer (setup screen, help texts).
SUPPORT_EMAIL=
# MailHarbor support and recovery account: created/repaired on every start when both are set.
# Leave empty until the customer has created their first administrator with the setup code.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Backups (daily to ./backups; optional off-site S3-compatible copy) ---
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR=2
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
