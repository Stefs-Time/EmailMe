# MailHarbor + listmonk — Docker Compose configuration.
# Copy to .env and replace EVERY value. Never commit .env.
# Generate strong secrets with:  openssl rand -base64 36

# --- Public DNS names (both must point at this server before first start) ---
# MailHarbor portal
PORTAL_DOMAIN=mail.example.co.za
# listmonk admin + unsubscribe/tracking links
LISTMONK_DOMAIN=lists.example.co.za
# Let's Encrypt expiry notices
ACME_EMAIL=it@example.co.za

# --- Organisation ---
ORG_NAME=Example (Pty) Ltd
TZ=Africa/Johannesburg

# --- PostgreSQL (internal only; never exposed) ---
POSTGRES_DB=listmonk
POSTGRES_USER=listmonk
POSTGRES_PASSWORD=change-me-db-owner-password
# Password for the portal's least-privilege database role (read-only on listmonk tables)
PORTAL_DB_PASSWORD=change-me-portal-db-password

# --- listmonk first administrator (created on first start only) ---
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=change-me-listmonk-admin-password

# --- Portal ---
# At least 32 random characters. Changing it signs everyone out.
SESSION_SECRET=change-me-to-at-least-32-random-characters
# First portal administrator (only used when no portal users exist).
# Remove PORTAL_ADMIN_PASSWORD from this file after the first start.
PORTAL_ADMIN_EMAIL=admin@example.co.za
PORTAL_ADMIN_PASSWORD=change-me-portal-admin-password
# Filled in after running the bootstrap script (see README step 4).
LISTMONK_API_USER=mailharbor
LISTMONK_API_TOKEN=
# true = an unsubscribe from any list suppresses the person from all marketing (POPIA-safe default)
GLOBAL_UNSUBSCRIBE=true

# --- Backups ---
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR=2
