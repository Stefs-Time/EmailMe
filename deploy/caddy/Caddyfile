# Caddy obtains and renews Let's Encrypt certificates automatically.
# Both DNS names must point at this server before the first start.
{
	email {$ACME_EMAIL}
}

# MailHarbor portal
{$PORTAL_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 30MB
	}
	reverse_proxy portal:3000
	header {
		-Server
	}
}

# listmonk: admin UI, plus the public unsubscribe / opt-in / tracking links
# that appear in every email, so this host must be publicly reachable.
{$LISTMONK_DOMAIN} {
	encode zstd gzip
	reverse_proxy listmonk:9000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
