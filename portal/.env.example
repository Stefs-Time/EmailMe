# MailHarbor — environment variables.
# Only the database and SMTP server are required. Everything else is configured
# in the app (Settings) after the first sign-in.

# --- Required ---
# On Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://user:password@localhost:5432/mailharbor
SMTP_HOST=smtp.example.co.za

# --- SMTP (usual) ---
# 587 = STARTTLS (default), 465 = TLS
SMTP_PORT=587
SMTP_USER=news@example.co.za
SMTP_PASSWORD=replace-me
# Default sender (editable in Settings)
SMTP_FROM="Example News <news@example.co.za>"

# --- Optional ---
# PORT is set by Railway. PUBLIC_URL is detected on Railway (RAILWAY_PUBLIC_DOMAIN)
# or set in Settings; set it here only to override.
# PUBLIC_URL=https://mail.example.co.za
# MailHarbor support address shown to the customer.
# SUPPORT_EMAIL=support@example.com
# Support and recovery administrator, re-applied on every start (both or neither).
# ADMIN_EMAIL=admin@example.co.za
# ADMIN_PASSWORD=a-strong-passphrase-2026
# Local development over plain http:
# NODE_ENV=development
# SMTP_REQUIRE_TLS=false
