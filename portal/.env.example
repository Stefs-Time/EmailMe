# MailHarbor portal — environment variables (local development / Railway).
# Copy to .env for local use; on Railway set these as service variables.

NODE_ENV=development
PORT=3000

# PostgreSQL shared with listmonk. Prefer the least-privilege `mailharbor` role
# (deploy/postgres/portal-role.sql). On Railway: ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://mailharbor:password@localhost:5432/listmonk
DATABASE_SSL=false
DATABASE_SSL_VERIFY=true
DATABASE_POOL_MAX=10

# Session signing secret: at least 32 random characters (openssl rand -base64 36).
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_MAX_AGE_HOURS=8
# auto = secure cookies when NODE_ENV=production (requires HTTPS)
COOKIE_SECURE=auto
TRUST_PROXY=1

# listmonk: internal URL for API calls, public URL for links shown to users.
LISTMONK_URL=http://localhost:9000
LISTMONK_PUBLIC_URL=https://lists.example.co.za
LISTMONK_API_USER=mailharbor
LISTMONK_API_TOKEN=replace-with-token-from-bootstrap-script
LISTMONK_TIMEOUT_MS=15000

# Business rules
GLOBAL_UNSUBSCRIBE=true
SYNC_INTERVAL_SECONDS=60
SYNC_STALE_MINUTES=15
IMPORT_MAX_ROWS=100000
IMPORT_MAX_MB=25

ORG_NAME=MailHarbor
LOG_LEVEL=info

# First administrator (used only when no portal users exist). Remove afterwards.
ADMIN_EMAIL=admin@example.co.za
ADMIN_PASSWORD=replace-with-a-strong-password
